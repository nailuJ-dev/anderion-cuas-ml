# syntax=docker/dockerfile:1.7
FROM rust:1.85.1-bookworm AS builder
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --release --locked --bin cuas-golden-demo

FROM debian:bookworm-slim
WORKDIR /app
COPY --from=builder /src/target/release/cuas-golden-demo /usr/local/bin/cuas-golden-demo
COPY demo-data ./demo-data
RUN mkdir -p /app/artifacts && chown -R 65532:65532 /app
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/cuas-golden-demo"]
